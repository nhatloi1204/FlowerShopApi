# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flowershop
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your-secret-key-must-be-at-least-32-characters-long-for-jwt
JWT_ISSUER=FlowerShop.API
JWT_AUDIENCE=FlowerShop.Client
JWT_EXPIRATION_MINUTES=60

# Application Configuration
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# Logging
LOG_LEVEL=Information
